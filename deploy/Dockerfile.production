# Dependencies only; application and integration source is mounted read-only.
FROM python:3.12-slim AS dependencies
ENV PIP_NO_CACHE_DIR=1
COPY requirements.txt /requirements.txt
RUN pip install --prefix=/install -r /requirements.txt
COPY integrations/sarvam_mcp/requirements.lock /mcp-requirements.lock
RUN python -m venv /opt/sarvam-mcp && /opt/sarvam-mcp/bin/pip install -r /mcp-requirements.lock

FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 SARVAM_MCP_PYTHON=/opt/sarvam-mcp/bin/python
COPY --from=dependencies /install /usr/local
COPY --from=dependencies /opt/sarvam-mcp /opt/sarvam-mcp
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --uid 1000 --create-home app \
    && mkdir -p /srv/data /srv/config && chown app:app /srv/data /srv/config
WORKDIR /app
USER app
EXPOSE 8000
CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000", "--ws-max-size", "8192", "--proxy-headers", "--forwarded-allow-ips", "*"]
