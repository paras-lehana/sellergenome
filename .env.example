# Copy to .env for local work; never commit actual values. Production env is outside source.
PUBLIC_BASE_PATH=/hackathon/seller-persona
SERVER_HOST=lehana-rig
DATA_DIR=./runtime
DATASET_DIR=./dataset
# A long random operator automation key. UI stores it only for the current browser session.
OPERATOR_API_KEY=
# Dedicated Elasticsearch; no shared production indices are modified.
ELASTICSEARCH_URL=http://seller-persona-elasticsearch:9200
ELASTICSEARCH_USERNAME=persona_app
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_INDEX_PREFIX=seller-persona
# All text inference through central gateway; BYOK auth and provider key remain server-only.
LLM_SERVICE_URL=https://llm.lehana.in
LLM_INTERNAL_KEY=
LLM_API_KEY=
LLM_PROVIDER=antigravity
LLM_MODEL=gemini-3-flash
# Sarvam speech adapter (central gateway has no Sarvam TTS transport).
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_SPEAKER=shubh
# Optional read-only source connectors; URL templates may contain {seller_id}.
CONTEXT_URL=
CONTEXT_API_KEY=
COMPANY_URL=
COMPANY_API_KEY=
STS_URL=
STS_API_KEY=
BUYLEADS_URL=
BUYLEADS_API_KEY=
ENQUIRY_URL=
ENQUIRY_API_KEY=
CHAT_URL=
CHAT_API_KEY=
PNS_URL=
PNS_API_KEY=
REDASH_URL=
REDASH_API_KEY=
# Comma-separated saved query IDs approved for execution, no arbitrary SQL.
REDASH_QUERY_IDS=

# Funded primary; backup activates only on explicit quota exhaustion.
# Real values live in /opt/secrets/env_files/seller-persona.env, mode 0600.
SARVAM_BACKUP_API_KEY=
